manifest {
    name = 'DIMPLE Freeze 5.3 multi-cloud research'
    version = '5.3.0-research-multicloud.2'
    nextflowVersion = '26.10.3'
}

params {
    input = null
    grid = null
    outdir = null
    image = null
    queue = null
    region = null
    job_role = null
    execution_role = null
    log_group = null
    google_project = null
    google_location = null
    google_service_account = null
    google_network = null
    google_subnetwork = null
    google_boot_disk_gib = 50
    seed_chunk = 25
    prepare_only = false
    queue_size = 16
    task_hours = 4
    prepare_memory_gib = 4
    umap_memory_gib = 4
    concat_memory_gib = 8
    grid_memory_gib = 8
    rank_memory_gib = 8
}

process {
    executor = 'local'
    cpus = 1
    errorStrategy = 'terminate'
    cache = 'deep'
    shell = ['/bin/bash', '-euo', 'pipefail']
    time = "${params.task_hours}h"
    withLabel: prepare { memory = "${params.prepare_memory_gib} GB" }
    withLabel: umap { memory = "${params.umap_memory_gib} GB" }
    withLabel: concat { memory = "${params.concat_memory_gib} GB" }
    withLabel: grid { memory = "${params.grid_memory_gib} GB" }
    withLabel: rank { memory = "${params.rank_memory_gib} GB" }
}

env {
    PYTHONDONTWRITEBYTECODE = '1'
    PYTHONHASHSEED = '0'
    NUMBA_NUM_THREADS = '1'
    OMP_NUM_THREADS = '1'
    OPENBLAS_NUM_THREADS = '1'
    MKL_NUM_THREADS = '1'
    NUMEXPR_NUM_THREADS = '1'
    NUMBA_CACHE_DIR = '/tmp/numba'
}

profiles {
    gcp {
        plugins { id 'nf-google@1.29.1' }
        process.executor = 'google-batch'
        process.machineType = 'n2-standard-4'
        process.container = params.image
        google.project = params.google_project
        google.location = params.google_location
        google.batch.serviceAccountEmail = params.google_service_account
        google.batch.network = params.google_network
        google.batch.subnetwork = params.google_subnetwork
        google.batch.bootDiskSize = "${params.google_boot_disk_gib} GB"
        google.batch.usePrivateAddress = true
        google.batch.preemptible = false
        google.batch.spot = false
        google.batch.maxSpotAttempts = 0
        // Worker image runs as UID 10001. Team PREPARE must qualify these mounts.
        google.batch.gcsfuseOptions = ['-o rw', '-o allow_other', '--implicit-dirs', '--uid=10001', '--gid=10001', '--file-mode=0664', '--dir-mode=0775']
        // Six 4-vCPU VMs per controller: 24 vCPU, below the reported 32 project quota.
        executor.queueSize = Math.min(6, params.queue_size as int)
        executor.pollInterval = '10 sec'
    }
    awsbatch {
        plugins { id 'nf-amazon@3.12.1' }
        process.executor = 'awsbatch'
        process.queue = params.queue
        process.container = params.image
        process.containerOptions = '--user 10001'
        aws.region = params.region
        aws.batch.jobRole = params.job_role
        aws.batch.executionRole = params.execution_role
        aws.batch.logsGroup = params.log_group
        executor.queueSize = params.queue_size
        executor.pollInterval = '10 sec'
    }
}

trace.enabled = true
trace.file = "${params.outdir}/nextflow/trace.txt"
report.enabled = true
report.file = "${params.outdir}/nextflow/report.html"
timeline.enabled = true
timeline.file = "${params.outdir}/nextflow/timeline.html"
trace.overwrite = false
report.overwrite = false
timeline.overwrite = false

trace.fields = 'task_id,hash,native_id,name,status,exit,submit,start,complete,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar'
